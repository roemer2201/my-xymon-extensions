#!/bin/sh
# Second call site of the conffile rename; dpkg-maintscript-helper needs
# the same calls in preinst, postinst and postrm.
set -e

# Conffile rename this package has been through: up to 0.15.0-1 the
# drop-ins were installed under their bare extension name, which
# collides with other packages in these shared directories -
# hobbit-plugins ships graphs.d/temp.cfg and xymonserver.d/temp.cfg,
# and dpkg refuses two packages that claim the same path. Since 0.16.0
# every file carries the package name.
#
# dpkg-maintscript-helper must see the same calls in preinst, postinst
# and postrm; it only touches files registered as conffiles of THIS
# package, so another package's temp.cfg is never affected.
migrate_conffiles() {
    # Only dpkg may drive this: the helper needs DPKG_MAINTSCRIPT_* in
    # the environment, and "supports" is the canonical availability
    # check. Outside dpkg (test suite, manual run) this is a no-op.
    [ -n "${DPKG_MAINTSCRIPT_NAME:-}" ] || return 0
    dpkg-maintscript-helper supports mv_conffile >/dev/null 2>&1 || return 0
    for ext in smart temp la memory opkg fritzdsl fritzwan wifi if_link xymonext; do
        for dropin in xymonserver.d graphs.d; do
            dpkg-maintscript-helper mv_conffile \
                "/etc/xymon/$dropin/$ext.cfg" \
                "/etc/xymon/$dropin/my-xymon-extensions-$ext.cfg" \
                0.15.0-1 -- "$@"
        done
    done
    dpkg-maintscript-helper mv_conffile \
        "/etc/xymon/rrddefinitions.d/if_link.cfg" \
        "/etc/xymon/rrddefinitions.d/my-xymon-extensions-if_link.cfg" \
        0.15.0-1 -- "$@"
}

migrate_conffiles "$@"

exit 0
