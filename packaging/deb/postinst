#!/bin/sh
# Third call site of the conffile migration (see preinst), plus the
# post-install notes.
set -e

# Conffile moves this package has been through. dpkg-maintscript-helper
# must see the same calls in preinst, postinst and postrm, so the list
# lives here and is sourced by all three.
#
#  0.14.0-1  snippets sat in the SERVER's drop-in directory tasks.d
#  0.15.0-1  moved to the client's clientlaunch.d, still named <ext>.cfg
#  0.16.0-1  renamed to my-xymon-extensions-<ext>.cfg, because
#            clientlaunch.d is shared: hobbit-plugins ships a temp.cfg
#            there too, and dpkg refuses two packages claiming one path
#
# Chained moves are fine: on an upgrade from 0.14.0 the first call moves
# tasks.d/x.cfg to clientlaunch.d/x.cfg and the second one renames it.
migrate_conffiles() {
    # Only dpkg may drive this: the helper needs DPKG_MAINTSCRIPT_* in
    # the environment, and "supports" is the canonical availability
    # check. Outside dpkg (test suite, manual run) this is a no-op.
    [ -n "${DPKG_MAINTSCRIPT_NAME:-}" ] || return 0
    dpkg-maintscript-helper supports mv_conffile >/dev/null 2>&1 || return 0
    for snippet in smart temp la memory disk opkg fritzdsl fritzwan wifi if_link; do
        dpkg-maintscript-helper mv_conffile \
            "/etc/xymon/tasks.d/$snippet.cfg" \
            "/etc/xymon/clientlaunch.d/$snippet.cfg" \
            0.14.0-1 -- "$@"
        dpkg-maintscript-helper mv_conffile \
            "/etc/xymon/clientlaunch.d/$snippet.cfg" \
            "/etc/xymon/clientlaunch.d/my-xymon-extensions-$snippet.cfg" \
            0.15.0-1 -- "$@"
    done
}

migrate_conffiles "$@"

case "${1:-}" in
    configure)
        cat <<'EOF'
my-xymon-extensions: to activate the "smart" extension:
 1. Grant the xymon user access to smartctl - see
    /usr/share/doc/my-xymon-extensions/smart/sudoers.example
 2. Restart the client: service xymon-client restart
    (on a host that also runs the Xymon server: service xymon restart)
 The snippets in /etc/xymon/clientlaunch.d/ need no further wiring on
 Debian/Ubuntu: the init script writes one include line per *.cfg into
 /var/run/xymon/clientlaunch-include.cfg at every start, and both
 clientlaunch.cfg and the server's tasks.cfg read that file. Hence a
 restart, not a reload.
 The "temp" extension is active as well; "la", "memory" and "disk"
 ship disabled (see /etc/xymon/clientlaunch.d) because a full Xymon
 client already reports this information itself.
The FRITZ!Box extensions "fritzdsl" and "fritzwan" ship disabled:
 configure /etc/xymon/fritzdsl.cfg resp. fritzwan.cfg, then remove
 the DISABLED line from the matching /etc/xymon/clientlaunch.d/
 snippet and restart the client on the polling host (normally the
 Xymon server).
The "wifi" extension ships disabled too: enable it (remove the
 DISABLED line from /etc/xymon/clientlaunch.d/wifi.cfg) only on a
 Linux access point with iw installed.
The "if_link" extension (link state changes per network interface)
 is active out of the box and adds an "if_link" column. It stays
 green until you configure thresholds in /etc/xymon/if_link.cfg.
Every task runs through /usr/lib/xymon/client/ext/xymonext.sh, which
 measures the extension and adds an "xymonext" column with runtime,
 CPU time and traffic per test. Set XYMONEXT_ENABLE="no" in
 /etc/xymon/xymonext.cfg to run the extensions directly again.
RRD graphs need a one-time setup on the Xymon SERVER: install the
 my-xymon-extensions-server package there, or copy the drop-in files
 from /usr/share/doc/my-xymon-extensions/<extension>/server/ by hand.
EOF
        # Up to 0.14.0-1 this package asked the admin to add a
        # "directory /etc/xymon/tasks.d" line to clientlaunch.cfg. The
        # snippets have moved, and on a server host that line makes the
        # server's xymonlaunch load them a second time.
        if [ -f /etc/xymon/clientlaunch.cfg ] &&
           grep -Eq '^[[:space:]]*directory[[:space:]]+/etc/xymon/tasks\.d[[:space:]]*$' \
                /etc/xymon/clientlaunch.cfg; then
            cat <<'EOF'
 NOTE: /etc/xymon/clientlaunch.cfg still contains
         directory /etc/xymon/tasks.d
 That line was needed by version 0.14.0 and older. The snippets now
 live in /etc/xymon/clientlaunch.d/ and are included automatically -
 remove the line. tasks.d belongs to the Xymon server; leaving the
 line in makes a server host run these extensions twice.
EOF
        fi
        ;;
esac

exit 0
