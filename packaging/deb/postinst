#!/bin/sh
# Third call site of the conffile migration (see preinst), plus the
# post-install notes.
set -e

# Conffile history of this package. dpkg-maintscript-helper must see
# the same calls in preinst, postinst and postrm.
#
#  0.14.0-1  snippets sat in the SERVER's drop-in directory tasks.d
#  0.15.0-1  moved to the client's clientlaunch.d
#  0.16.0-1  briefly renamed to my-xymon-extensions-<ext>.cfg
#  0.17.0-1  back to <ext>.cfg, and the temp snippet is no longer
#            installed at all: clientlaunch.d/temp.cfg belongs to
#            hobbit-plugins on Debian/Ubuntu, and dpkg refuses two
#            packages that claim one path. It ships as documentation
#            instead (see the post-install output).
#  0.20.0-1  the per-extension CONFIG files move out of the shared
#            /etc/xymon into /etc/xymon/my-xymon-extensions/. The
#            launch snippets stay in clientlaunch.d, which is Xymon's
#            own drop-in directory and has to be.
#  0.29.0-1  fritzdsl and fritzwan leave this package: they are modules
#            of the server-only fritzbox collector now
#            (my-xymon-extensions-server).
#
# The moves are chained, so an upgrade from any of those versions lands
# on the current layout. mv_conffile/rm_conffile only ever touch files
# registered as conffiles of THIS package - another package's temp.cfg
# is never affected (ensure_package_owns_file in the helper).
migrate_conffiles() {
    # Only dpkg may drive this: the helper needs DPKG_MAINTSCRIPT_* in
    # the environment, and "supports" is the canonical availability
    # check. Outside dpkg (test suite, manual run) this is a no-op.
    [ -n "${DPKG_MAINTSCRIPT_NAME:-}" ] || return 0
    dpkg-maintscript-helper supports mv_conffile >/dev/null 2>&1 || return 0

    for snippet in smart la memory disk opkg wifi if_link; do
        dpkg-maintscript-helper mv_conffile \
            "/etc/xymon/tasks.d/$snippet.cfg" \
            "/etc/xymon/clientlaunch.d/$snippet.cfg" \
            0.14.0-1 -- "$@"
        dpkg-maintscript-helper mv_conffile \
            "/etc/xymon/clientlaunch.d/my-xymon-extensions-$snippet.cfg" \
            "/etc/xymon/clientlaunch.d/$snippet.cfg" \
            0.16.0-1 -- "$@"
    done

    # temp: dropped from the package, wherever it may sit. A version
    # you edited is kept as .dpkg-bak by the helper.
    dpkg-maintscript-helper rm_conffile \
        "/etc/xymon/tasks.d/temp.cfg" 0.14.0-1 -- "$@"
    dpkg-maintscript-helper rm_conffile \
        "/etc/xymon/clientlaunch.d/temp.cfg" 0.15.0-1 -- "$@"
    dpkg-maintscript-helper rm_conffile \
        "/etc/xymon/clientlaunch.d/my-xymon-extensions-temp.cfg" 0.16.0-1 -- "$@"

    # 0.20.0-1: config files into this package's own directory. temp is
    # in the list: its CONFIG file is ours - only its launch snippet
    # and its server drop-ins are hobbit-plugins' territory.
    for cfg in smart temp la memory disk opkg wifi \
        if_link lxc claude xymonext; do
        dpkg-maintscript-helper mv_conffile \
            "/etc/xymon/$cfg.cfg" \
            "/etc/xymon/my-xymon-extensions/$cfg.cfg" \
            0.20.0-1 -- "$@"
    done

    # 0.29.0-1: fritzdsl and fritzwan are gone from this package. Their
    # configs and launch snippets go too, wherever an older version left
    # them; one you edited is kept as .dpkg-bak by the helper (its
    # settings map to the fritzbox collector's config, see its README).
    for ext in fritzdsl fritzwan; do
        for path in "/etc/xymon/tasks.d/$ext.cfg" \
            "/etc/xymon/clientlaunch.d/my-xymon-extensions-$ext.cfg" \
            "/etc/xymon/clientlaunch.d/$ext.cfg" \
            "/etc/xymon/$ext.cfg" \
            "/etc/xymon/my-xymon-extensions/$ext.cfg"; do
            dpkg-maintscript-helper rm_conffile "$path" 0.29.0-1~ -- "$@"
        done
    done
}

migrate_conffiles "$@"

case "${1:-}" in
    configure)
        # $2 is the version configured before this one, empty on a
        # first install. Only an upgrade from before 0.20.0-1 had its
        # config files moved by migrate_conffiles above.
        if [ -n "${2:-}" ] &&
           dpkg --compare-versions "$2" lt 0.20.0-1 2>/dev/null; then
            cat <<'EOF'
my-xymon-extensions: the per-extension configuration now lives in
 /etc/xymon/my-xymon-extensions/ instead of straight in /etc/xymon,
 which on Debian/Ubuntu is shared with the Xymon server and
 hobbit-plugins. dpkg has moved your files, edits included; the launch
 snippets stay in /etc/xymon/clientlaunch.d, where Xymon expects them.
EOF
        else
            cat <<'EOF'
my-xymon-extensions: configuration in /etc/xymon/my-xymon-extensions/,
 launch snippets in /etc/xymon/clientlaunch.d/.
EOF
        fi
        cat <<'EOF'
To activate the "smart" extension:
 1. Grant the xymon user access to smartctl - see
    /usr/share/doc/my-xymon-extensions/smart/sudoers.example
 2. Restart the client: service xymon-client restart
    (on a host that also runs the Xymon server: service xymon restart)
 The snippets in /etc/xymon/clientlaunch.d/ need no further wiring on
 Debian/Ubuntu: the init script writes one include line per *.cfg into
 /var/run/xymon/clientlaunch-include.cfg at every start, and both
 clientlaunch.cfg and the server's tasks.cfg read that file. Hence a
 restart, not a reload.
 "la", "memory" and "disk" ship disabled (see
 /etc/xymon/clientlaunch.d) because a full Xymon client already
 reports this information itself.
The "temp" extension is installed, but its xymonlaunch snippet is NOT:
 /etc/xymon/clientlaunch.d/temp.cfg is a file name hobbit-plugins
 already ships, and dpkg refuses two packages claiming one path. To
 schedule the temp test on this host, copy the snippet in place once:
   cp /usr/share/doc/my-xymon-extensions/temp/clientlaunch.d/temp.cfg \
      /etc/xymon/clientlaunch.d/
 (If hobbit-plugins is installed, that overwrites its temp.cfg - which
 is what you want unless you use ITS temp plugin: both define a [temp]
 task, and xymonlaunch merges same-named sections into one.)
The FRITZ!Box extensions "fritzdsl" and "fritzwan" are no longer part
 of this package: since 0.29.0 they are modules of the fritzbox
 collector in my-xymon-extensions-server. Configs you had edited were
 kept as .dpkg-bak; see
 /usr/share/doc/my-xymon-extensions-server/fritzbox/README.md.
The "wifi" extension ships disabled too: enable it (remove the
 DISABLED line from /etc/xymon/clientlaunch.d/wifi.cfg) only on a
 Linux access point with iw installed.
The "if_link" extension (link state changes per network interface)
 is active out of the box and adds an "if_link" column. It stays
 green until you configure thresholds in /etc/xymon/my-xymon-extensions/if_link.cfg.
The "systemd" extension is active out of the box and adds a "systemd"
 column: system state, failed units and automatic service restarts
 (a restart keeps the column yellow for 30 minutes). List the units
 that must run in SYSD_REQUIRED, or set SYSD_ENABLE="no" to switch it
 off, in /etc/xymon/my-xymon-extensions/systemd.cfg.
The "bcache" extension ships disabled: on a host with bcache devices,
 uncomment the task in /etc/xymon/clientlaunch.d/bcache.cfg. It needs
 no configuration; if $XYMONTMP is a tmpfs, set BCACHE_STATEDIR in
 /etc/xymon/my-xymon-extensions/bcache.cfg so that vanished devices
 are still detected after a reboot.
The "btrfs" extension is active out of the box and adds a "btrfs"
 column for every mounted btrfs filesystem (clear on hosts without
 one): device state and errors, unallocated space, metadata, scrub
 age and performance. The scrub RESULT needs a sudo rule - see
 /usr/share/doc/my-xymon-extensions/btrfs/sudoers.example and
 BTRFS_SUDO in /etc/xymon/my-xymon-extensions/btrfs.cfg.
The "lxc" extension ships disabled: on an LXC host, remove the
 DISABLED line from /etc/xymon/clientlaunch.d/lxc.cfg. It needs no
 configuration - which containers are supposed to run is taken from
 lxc.start.auto, /etc/config/lxc-auto and lxc-autostart; override it
 in /etc/xymon/my-xymon-extensions/lxc.cfg with LXC_REQUIRED if you want an explicit list.
The "claude" extension ships disabled: it reports how much longer the
 Claude Code login of an account is valid - yellow 10 days before it
 expires, red 5 days - so a headless session is renewed before it
 breaks. Setting it up takes two steps, because the credentials file
 is mode 0600 in a private home directory:
   1. Allow the xymon user to run the reader as root - see
      /usr/share/doc/my-xymon-extensions/claude/sudoers.example (it
      ships one line for the "root" account; add a line per further
      account you want checked).
   2. List those accounts in CLAUDE_ACCOUNTS in /etc/xymon/my-xymon-extensions/claude.cfg,
      then uncomment the task in /etc/xymon/clientlaunch.d/claude.cfg.
Every task runs through /usr/lib/xymon/client/ext/xymonext.sh, which
 measures the extension and adds an "xymonext" column with runtime,
 CPU time and traffic per test. Set XYMONEXT_ENABLE="no" in
 /etc/xymon/my-xymon-extensions/xymonext.cfg to run the extensions directly again.
RRD graphs need a one-time setup on the Xymon SERVER: install the
 my-xymon-extensions-server package there, or copy the drop-in files
 from /usr/share/doc/my-xymon-extensions/<extension>/server/ by hand.
EOF
        # Up to 0.14.0-1 this package asked the admin to add a
        # "directory /etc/xymon/tasks.d" line to clientlaunch.cfg. The
        # snippets have moved, and on a server host that line makes the
        # server's xymonlaunch load them a second time.
        if [ -f /etc/xymon/clientlaunch.cfg ] &&
           grep -Eq '^[[:space:]]*directory[[:space:]]+/etc/xymon/tasks\.d[[:space:]]*$' \
                /etc/xymon/clientlaunch.cfg; then
            cat <<'EOF'
 NOTE: /etc/xymon/clientlaunch.cfg still contains
         directory /etc/xymon/tasks.d
 That line was needed by version 0.14.0 and older. The snippets now
 live in /etc/xymon/clientlaunch.d/ and are included automatically -
 remove the line. tasks.d belongs to the Xymon server; leaving the
 line in makes a server host run these extensions twice.
EOF
        fi
        ;;
esac

exit 0
