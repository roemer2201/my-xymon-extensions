#!/bin/sh
set -e

case "${1:-}" in
    configure)
        cat <<'EOF'
my-xymon-extensions: to activate the "smart" extension:
 1. Grant the xymon user access to smartctl - see
    /usr/share/doc/my-xymon-extensions/smart/sudoers.example
 2. Make sure /etc/xymon/clientlaunch.cfg loads the tasks.d directory
    (add this line once if it is missing):
      directory /etc/xymon/tasks.d
 3. Restart the client: service xymon-client restart
 The "temp" extension is active via tasks.d as well; "la", "memory"
 and "disk" ship disabled (see /etc/xymon/tasks.d) because a full
 Xymon client already reports this information itself.
The FRITZ!Box extensions "fritzdsl" and "fritzwan" ship disabled:
 configure /etc/xymon/fritzdsl.cfg resp. fritzwan.cfg, then remove
 the DISABLED line from the matching /etc/xymon/tasks.d/ snippet and
 restart the client on the polling host (normally the Xymon server).
The "wifi" extension ships disabled too: enable it (remove the
 DISABLED line from /etc/xymon/tasks.d/wifi.cfg) only on a Linux
 access point with iw installed.
The "if_link" extension (link state changes per network interface)
 is active out of the box and adds an "if_link" column. It stays
 green until you configure thresholds in /etc/xymon/if_link.cfg.
Every task runs through /usr/lib/xymon/client/ext/xymonext.sh, which
 measures the extension and adds an "xymonext" column with runtime,
 CPU time and traffic per test. Set XYMONEXT_ENABLE="no" in
 /etc/xymon/xymonext.cfg to run the extensions directly again.
EOF
        ;;
esac

exit 0
