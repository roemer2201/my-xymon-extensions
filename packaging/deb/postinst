#!/bin/sh
set -e

case "${1:-}" in
    configure)
        cat <<'EOF'
my-xymon-extensions: to activate the "smart" extension:
 1. Grant the xymon user access to smartctl - see
    /usr/share/doc/my-xymon-extensions/smart/sudoers.example
 2. Make sure /etc/xymon/clientlaunch.cfg loads the tasks.d directory
    (add this line once if it is missing):
      directory /etc/xymon/tasks.d
 3. Restart the client: service xymon-client restart
 The "temp" extension is active via tasks.d as well; "la" and "memory"
 ship disabled (see /etc/xymon/tasks.d) because a full Xymon client
 already reports this information itself.
The FRITZ!Box extensions "fritzdsl" and "fritzwan" ship disabled:
 configure /etc/xymon/fritzdsl.cfg resp. fritzwan.cfg, then remove
 the DISABLED line from the matching /etc/xymon/tasks.d/ snippet and
 restart the client on the polling host (normally the Xymon server).
EOF
        ;;
esac

exit 0
