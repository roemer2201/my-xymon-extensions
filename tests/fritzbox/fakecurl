#!/bin/sh
# fakecurl - stands in for curl in tests/fritzbox/run.sh. Replays the
# anonymized TR-064/IGD responses in data/ (FB_OVER first, so a test can
# replace single answers), checks the credentials that fritzbox.sh
# passes on stdin ("curl --config -") and logs every requested action.
# Never talks to the network.
#
# Environment:
#   FB_DATA      fixture directory    FB_OVER   override directory
#   FB_LOG       log directory
#   FB_USER/FB_PASS  expected credentials (401 otherwise)
#   FB_DOWN      host names/IPs that refuse connections (curl exit 7)
#   FB_NOIGD=1   /igddesc.xml answers 404 (UPnP status info disabled)
#
# Response files are named CONTROL__ACTION[__INDEX].xml: CONTROL is the
# last part of a /upnp/control/ URL, else the URL path with "/" -> "_".
# A missing indexed file is the UPnP error 713 (end of the list).
set -u
printf '%s\n' "$*" >>"${FB_LOG}/argv"
[ -z "${FRITZPASSWORT+x}" ] || printf 'FRITZPASSWORT reached curl\n' >>"${FB_LOG}/envleak"

out='' url='' action='' data='' config=0 digest=0 ntlm=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --output) out=$2; shift 2 ;;
        --write-out) shift 2 ;;
        --header)
            case "$2" in
                SoapAction:*) action=${2#*#}; action=${action%\"} ;;
            esac
            shift 2 ;;
        --data) data=$2; shift 2 ;;
        --config) [ "$2" = - ] || { echo "fakecurl: config not on stdin" >&2; exit 2; }
                  config=1; shift 2 ;;
        --connect-timeout|--max-time) shift 2 ;;
        --digest) digest=1; shift ;;
        --ntlm) ntlm=1; shift ;;
        --anyauth|--basic) echo "fakecurl: $1 may send the password in clear text" >&2; exit 98 ;;
        --silent|--show-error) shift ;;
        -*) echo "fakecurl: unexpected option $1" >&2; exit 2 ;;
        *) url=$1; shift ;;
    esac
done

# respond CODE FILE - write the body, print the HTTP code (--write-out).
respond() {
    # SOAP faults use HTTP 500, including when a test overrides a reply.
    if [ "$1" = 200 ] && [ -n "$2" ] && grep -q '<s:Fault>' "$2"; then
        set -- 500 "$2"
    fi
    if [ -n "$2" ]; then cat "$2" >"$out"; else : >"$out"; fi
    printf '%s' "$1"
    exit 0
}
# pick NAME - the override or the fixture file, empty when neither exists.
pick() {
    if [ -n "${FB_OVER:-}" ] && [ -f "${FB_OVER}/$1" ]; then printf '%s' "${FB_OVER}/$1"
    elif [ -f "${FB_DATA}/$1" ]; then printf '%s' "${FB_DATA}/$1"; fi
}

hostport=${url#http://}
host=${hostport%%:*}
path=/${hostport#*/}
case " ${FB_DOWN:-} " in *" $host "*)
    echo "curl: (7) Failed to connect to $host port 49000 after 2 ms: Couldn't connect to server" >&2
    printf '000'; exit 7 ;;
esac

if [ -z "$data" ]; then
    # Plain GETs: descriptions and the host list session URL.
    [ "$config" = 0 ] || { echo "fakecurl: credentials sent with a GET" >&2; exit 97; }
    printf 'GET %s\n' "${path%%\?*}" >>"${FB_LOG}/actions"
    case "$path" in
        /tr64desc.xml) respond 200 "$(pick tr64desc.xml)" ;;
        /igddesc.xml) [ "${FB_NOIGD:-0}" = 0 ] || respond 404 ''; respond 200 "$(pick igddesc.xml)" ;;
        /devicehostlist.lua\?sid=0123456789abcdef) respond 200 "$(pick hostlist.xml)" ;;
    esac
    respond 404 ''
fi

case "$path" in
    /upnp/control/*) ctl=${path#/upnp/control/}; auth=1 ;;
    /igdupnp/*|/igd2upnp/*) ctl=$(printf '%s' "${path#/}" | tr / _); auth=0 ;;
    *) respond 404 '' ;;
esac

# A single auth method makes curl probe with an empty body first.
if [ "$config" = 1 ] && [ "$digest" = 1 ] && [ "$ntlm" = 0 ]; then
    respond 500 "$FB_DATA/fault502.xml"
fi

# Digest credentials arrive as one curl config line: user = "USER:PASS"
# with \\ and \" escaped. Unescape and compare, like the device would.
# IGD needs no login; an empty config line is fine there.
creds=bad
if [ "$config" = 1 ]; then
    line=$(cat)
    got=$(printf '%s\n' "$line" | awk '
        /^user = "/ {
            s = substr($0, 9); v = ""
            for (i = 1; i <= length(s); i++) {
                c = substr(s, i, 1)
                if (c == "\\") { i++; v = v substr(s, i, 1); continue }
                if (c == "\"") { rest = substr(s, i + 1); break }
                v = v c
            }
            if (rest == "") print v
        }')
    [ "$got" != "${FB_USER}:${FB_PASS}" ] || creds=ok
fi
[ "$auth" = 0 ] || [ "$creds" = ok ] || respond 401 "$FB_DATA/unauthorized.html"

printf '%s %s\n' "$ctl" "$action" >>"${FB_LOG}/actions"
case "$action" in
    Get*|X_AVM-DE_Get*|X_AVM_DE_Get*) ;;
    *) echo "fakecurl: action $action is not read-only" >&2; exit 99 ;;
esac
case "$action" in
    GetSecurityKeys|X_AVM-DE_GetVoIPAccount|X_AVM-DE_GetClient*)
        echo "fakecurl: action $action returns secrets" >&2; exit 96 ;;
esac
# The device answers a self-closing action element with UPnP error 502.
case "$data" in *"</u:${action}>"*) ;; *) respond 500 "$FB_DATA/fault502.xml" ;; esac

idx=$(printf '%s' "$data" | sed -n 's/.*<New[A-Za-z]*Index>\([0-9]*\)<.*/\1/p')
if [ -n "$idx" ]; then
    f=$(pick "${ctl}__${action}__${idx}.xml")
    [ -n "$f" ] || respond 500 "$FB_DATA/fault713.xml"
    respond 200 "$f"
fi
f=$(pick "${ctl}__${action}.xml")
[ -n "$f" ] || respond 500 "$FB_DATA/fault401.xml"
respond 200 "$f"
