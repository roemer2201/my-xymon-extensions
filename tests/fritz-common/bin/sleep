#!/bin/sh
# Advance the synthetic clock instead of waiting. Extra seconds emulate
# a delayed wake-up, so a retry's reserved time can expire during sleep.
# Env: FRITZ_TEST_CLOCK_FILE, FRITZ_TEST_SLEEP_EXTRA (default 0).
# Version: 1.0.0 (2026-10-22)
set -u
case "${1:-}" in -h|--help) printf '%s\n' 'Usage: sleep SECONDS; advances FRITZ_TEST_CLOCK_FILE.'; exit 0 ;; esac
clock=$(cat "${FRITZ_TEST_CLOCK_FILE}") || exit 1
awk -v t="${clock}" -v s="${1}" -v e="${FRITZ_TEST_SLEEP_EXTRA:-0}" \
    'BEGIN { printf "%.0f\n", t + s + e }' >"${FRITZ_TEST_CLOCK_FILE}"
