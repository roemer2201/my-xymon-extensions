#!/bin/sh
# Minimal curl stand-in for the fritzwan unit tests: emulates the
# options fritzwan.sh uses (--config -, --output FILE, --write-out
# '%{http_code}', --header, --data) and returns canned TR-064/UPnP
# responses depending on the SOAPACTION header.
#
# Failure modes for the tests, selected via environment variables:
#   FAKECURL_FAIL=1         transport error (exit 7, nothing on stdout)
#   FAKECURL_401=1          HTTP 401 on every request
#   FAKECURL_CLP=FILE|404   response for GetCommonLinkProperties
#   FAKECURL_ADDON=FILE|404 response for GetAddonInfos
set -u

OUT="/dev/null"
ACTION=""
prev=""
for arg; do
    case "$prev" in
        --output|-o)
            OUT=$arg
            ;;
        --header|-H)
            case "$arg" in
                SOAPACTION:*)
                    ACTION=${arg##*#}
                    ACTION=${ACTION%\"}
                    ;;
            esac
            ;;
    esac
    prev=$arg
done

# Consume the curl config arriving on stdin via "--config -".
cat > /dev/null

if [ "${FAKECURL_FAIL:-0}" = "1" ]; then
    echo "curl: (7) Failed to connect to fritz.box port 49000: Connection refused" >&2
    exit 7
fi

if [ "${FAKECURL_401:-0}" = "1" ]; then
    printf '<html>401 Unauthorized</html>\n' > "$OUT"
    printf '401'
    exit 0
fi

notfound() {
    printf '404 Not Found\n' > "$OUT"
    printf '404'
    exit 0
}

datadir="$(dirname "$0")/data"

case "$ACTION" in
    GetCommonLinkProperties)
        [ "${FAKECURL_CLP:-}" = "404" ] && notfound
        cat "${FAKECURL_CLP:-$datadir/clp-ok.xml}" > "$OUT"
        ;;
    GetAddonInfos)
        [ "${FAKECURL_ADDON:-}" = "404" ] && notfound
        cat "${FAKECURL_ADDON:-$datadir/addon-ok.xml}" > "$OUT"
        ;;
    GetTotalBytesReceived)
        cat "$datadir/totals-rx.xml" > "$OUT"
        ;;
    GetTotalBytesSent)
        cat "$datadir/totals-tx.xml" > "$OUT"
        ;;
    *)
        printf '500'
        exit 0
        ;;
esac
printf '200'
exit 0
