#!/bin/sh
# Deterministic read-only PLC stand-in. No networking or privilege changes.
set -u
base=${PL_FIXTURES:?}
# Simulates a helper that reads stdin (the collector must pass /dev/null).
[ -z "${PL_READ_STDIN:-}" ] || cat >/dev/null
case "${1}" in
    topology)
        case "${PL_TOPOLOGY:-both}" in
            both) cat "${base}/topology" ;;
            # A third, occasionally plugged-in adapter next to the two.
            garage) cat "${base}/topology"
                printf '%s\n' ' REM STA 005 02:00:00:00:00:0C 02:00:00:00:00:0D 98 91 QCA7500 MAC-QCA7500-3.0.0.0-00-20251112-CS' ;;
            local) sed '/ REM /d' "${base}/topology" ;;
            empty) exit 0 ;;
            broken) printf '%s\n' 'unexpected output'; exit 0 ;;
            denied) printf '%s\n' 'Operation not permitted' >&2; exit 1 ;;
        esac ;;
    rates)
        [ "${PL_EMPTY_RATES:-0}" = 0 ] || exit 0
        case "${3}" in
            f0:b0:14:84:c5:3c) peers=e8:df:70:1d:65:a6
                [ "${PL_TOPOLOGY:-both}" != garage ] || peers="${peers} 02:00:00:00:00:0c" ;;
            *) peers=f0:b0:14:84:c5:3c ;;
        esac
        for peer in ${peers}; do
            printf '%s %s %s TX 152 mbps Primary\n' "${2}" "${3}" "${peer}"
            printf '%s %s %s RX 145 mbps Primary\n' "${2}" "${3}" "${peer}"
        done ;;
    stats)
        [ "${PL_EMPTY_STATS:-0}" = 0 ] || exit 0
        cat "${base}/${PL_STATS:-stats1}" ;;
    *) exit 2 ;;
esac
