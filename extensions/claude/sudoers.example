# sudoers rule for the Xymon "claude" extension: lets the xymon user run
# claude-expiry.sh as root, which prints the login expiry of the named
# account and never any token.
#
# Install with visudo -f /etc/sudoers.d/xymon-claude (FreeBSD:
# /usr/local/etc/sudoers.d/xymon-claude). Keep one uncommented line per
# account and platform: the user name in the rule is what limits it to
# those accounts. Hosts where the client runs as root need no rule -
# set CLAUDE_SUDO="no" there.

# Debian/Ubuntu and Rocky/EL - the default account:
xymon ALL=(root) NOPASSWD: /usr/lib/xymon/client/ext/claude-expiry.sh root

# Rocky/EL with the EPEL xymon-client package (different prefix):
#xymon ALL=(root) NOPASSWD: /usr/share/xymon-client/ext/claude-expiry.sh root

# FreeBSD (net-mgmt/xymon-client):
#xymon ALL=(root) NOPASSWD: /usr/local/www/xymon/client/ext/claude-expiry.sh root

# Further accounts: one line each, and add them to CLAUDE_ACCOUNTS:
#xymon ALL=(root) NOPASSWD: /usr/lib/xymon/client/ext/claude-expiry.sh deploy
#
# Never write the rule without the argument - that allows every account.
