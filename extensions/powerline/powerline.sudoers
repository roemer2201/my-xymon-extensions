# EXAMPLE ONLY: inspect, then install root:root mode 0440 under /etc/sudoers.d.
# The helper path below is filled in by the packaging on install; check it
# against the file you actually have before using this rule.
# The root-owned helper validates operation/interface/MAC and fixes tool args.
# Its file and every parent directory must be unwritable by xymon.
# Never grant sudo for the collector, arbitrary shell, or unrestricted plctool.
xymon ALL=(root) NOPASSWD: @BINDIR@/powerline-read.sh
